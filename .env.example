# Copy to .env.local and fill in for production behavior.
# Without these set, the site still works: the contact form logs leads to
# the server console, and Book a Call shows a fallback contact card.

# Calendly (or Cal.com) embed URL, used on /book-a-call
NEXT_PUBLIC_CALENDLY_URL=

# Web3Forms (https://web3forms.com) access key, used to email lead-form
# submissions. Free, no account required — get a key by entering your email
# at web3forms.com. The key itself designates which inbox receives leads.
# Must be NEXT_PUBLIC_ (submitted client-side) — Web3Forms rejects requests
# that don't originate from a browser, so a server-proxied call won't work.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# SQLite file backing the future-schema demo (see
# docs/architecture/future-schema.md and /internal/demo). Not a secret —
# defaults to a local file, works with zero setup. Run `npx prisma migrate
# dev` then `npx prisma db seed` after copying this file to create it.
DATABASE_URL="file:./dev.db"
