# Copy to .env (not .env.local) and fill in for production behavior — the
# Prisma CLI (migrate/seed) only reads .env, so DATABASE_URL below needs to
# live there; Next.js itself reads both. Without these set, the site still
# works: the contact form logs leads to the server console, and Book a Call
# shows a fallback contact card.

# Calendly (or Cal.com) embed URL, used on /book-a-call
NEXT_PUBLIC_CALENDLY_URL=

# Web3Forms (https://web3forms.com) access key, used to email lead-form
# submissions. Free, no account required — get a key by entering your email
# at web3forms.com. The key itself designates which inbox receives leads.
# Must be NEXT_PUBLIC_ (submitted client-side) — Web3Forms rejects requests
# that don't originate from a browser, so a server-proxied call won't work.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Postgres connection string backing the future-schema demo (see
# docs/architecture/future-schema.md and /internal/demo). A real secret —
# never commit an actual value. Get a free instance from Neon or Supabase,
# then run `npx prisma migrate dev` followed by `npm run db:seed` after
# setting this to create and populate the schema.
DATABASE_URL=

# Optional HTTP Basic Auth gate for /internal/* (demo + admin pages) and
# /api/admin/* (lead conversion, referral redemption). Leave both unset to
# keep these pages open, matching this repo's zero-config fallback pattern —
# set both to lock them down for a real deployment.
ADMIN_USER=
ADMIN_PASSWORD=
